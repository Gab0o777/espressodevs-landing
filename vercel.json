{
  "rewrites": [
    { "source": "/",           "destination": "/index.html"             },
    { "source": "/turnix",     "destination": "/turnix/index.html"      },
    { "source": "/turnix/",    "destination": "/turnix/index.html"      },
    { "source": "/terminos",   "destination": "/turnix/terminos.html"   },
    { "source": "/privacidad", "destination": "/turnix/privacidad.html" },
    { "source": "/calendi",            "destination": "/calendi/index.html"      },
    { "source": "/calendi/",           "destination": "/calendi/index.html"      },
    { "source": "/calendi/terminos",   "destination": "/calendi/terminos.html"   },
    { "source": "/calendi/privacidad", "destination": "/calendi/privacidad.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options",    "value": "nosniff" },
        { "key": "X-Frame-Options",           "value": "DENY" },
        { "key": "X-XSS-Protection",          "value": "1; mode=block" },
        { "key": "Referrer-Policy",           "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",        "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/assets/:file",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/turnix/assets/:file",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/calendi/assets/:file",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
